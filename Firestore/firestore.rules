// MoveLoad Firestore rules.
//
// Kept in the repository so they stop being invisible state that only exists
// in a console. They are NOT deployed from here — paste the whole file into
// Firebase > Firestore Database > Rules, and update it in the same change so
// the two never drift.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // --- Identity --------------------------------------------------------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /teams/{teamId} {
      allow read, write: if signedIn();

      match /members/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // Who is in this squad: one small pointer per athlete, name and gender
      // only. This is how the dashboard *finds* athletes now that their data
      // no longer lives under the team — and it is why `athletes` itself
      // never has to be listed.
      match /roster/{athleteId} {
        allow read, write: if signedIn();
      }

      // --- Legacy path, phase A only ------------------------------------
      // The pre-migration shape. Deleted in phase C with the documents.
      match /athletes/{athleteId} {
        allow read, write: if signedIn();
        match /{document=**} {
          allow read, write: if signedIn();
        }
      }
    }

    // --- Athletes and their data ----------------------------------------
    // Stored once, whatever the memberships: an athlete in two squads has one
    // copy of their sessions, not one copy per team prefix. That is the whole
    // point of step 2, and it is independent of who may read them.
    match /athletes/{athleteId} {
      // `get`, deliberately not `read`: the collection must not be
      // enumerable. Finding an athlete means going through a team's roster,
      // which needs the team id — exactly the protection that existed before
      // the migration, no more and no less. Ids are UUIDs, so a `get` is not
      // a way in.
      //
      // Per-membership rules were tried here and withdrawn: they refused a
      // `get` on an athlete that does not exist yet (`resource` is null, so
      // `resource.data` fails evaluation rather than returning false), and
      // they refused the collection query outright even for a document whose
      // teamIds matched. Both were measured against the live project. Real
      // membership rules land in step 3, with an emulator to test them
      // against instead of a production database.
      allow get: if signedIn();
      allow write: if signedIn();

      // Sessions, HRV tests and the coach's thresholds. Rules do not cascade,
      // so a recursive match is what covers them — the lesson of the rule that
      // named `sessions` and silently refused `hrv` and `config`.
      //
      // The leading {subcollection} is load-bearing. A bare `/{document=**}`
      // matches *zero* or more segments in rules_version 2, so it also matches
      // the athlete document itself and grants it `read` — which includes
      // `list`, quietly undoing the `get`-only rule above and making every
      // athlete in the project enumerable without any team id. Requiring one
      // segment first confines this to everything *below* an athlete.
      match /{subcollection}/{document=**} {
        allow read, write: if signedIn();
      }
    }
  }
}
