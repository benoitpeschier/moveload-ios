    "le capteur n'a pas répondu à %@. Il est connecté mais ne parle pas — coupe le Bluetooth et rallume-le, ou redémarre le capteur en le sortant de la sangle.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the sensor did not answer %@. It is connected but not talking — turn Bluetooth off and on again, or restart the sensor by taking it off the strap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le capteur n'a pas répondu à %@. Il est connecté mais ne parle pas — coupe le Bluetooth et rallume-le, ou redémarre le capteur en le sortant de la sangle."
          }
        }
      }
    },
