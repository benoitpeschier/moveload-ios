        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos séances sont enregistrées sous ce compte. En vous connectant avec la même adresse sur un autre téléphone, vous les retrouverez."
          }
        }
      }
    },
    "Vérifie que le flux d'intervalles R-R arrive et qu'il est cohérent, avant que le test HRV s'appuie dessus. Chaque ligne est un battement.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks that the stream of R-R intervals arrives and holds together, before the HRV test relies on it. Each line is one beat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que le flux d'intervalles R-R arrive et qu'il est cohérent, avant que le test HRV s'appuie dessus. Chaque ligne est un battement."
          }
        }
      }
    },
