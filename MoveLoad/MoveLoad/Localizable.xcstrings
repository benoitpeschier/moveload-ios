    "séance %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "session %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "séance %@"
          }
        }
      }
    },
    "À faire valider par ton coach : c'est un repère, pas un diagnostic.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have your coach confirm it: it is a marker, not a diagnosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À faire valider par ton coach : c'est un repère, pas un diagnostic."
          }
        }
      }
    },
    "À la quatrième, les suivantes n'apparaîtront plus dans cette liste. Télécharge celles qui manquent, puis efface la mémoire du capteur.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the fourth, the ones after it stop appearing in this list. Download what is missing, then erase the sensor’s memory."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la quatrième, les suivantes n'apparaîtront plus dans cette liste. Télécharge celles qui manquent, puis efface la mémoire du capteur."
          }
        }
      }
    },
    "À lire sangle en place. Un téléphone connecté empêche le démarrage automatique, volontairement : ceci dit ce que le capteur perçoit, pas ce qu'il ferait sans toi.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read it with the strap on. A connected phone blocks the automatic start by design: this says what the sensor perceives, not what it would do without you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À lire sangle en place. Un téléphone connecté empêche le démarrage automatique, volontairement : ceci dit ce que le capteur perçoit, pas ce qu'il ferait sans toi."
          }
        }
      }
    },
    "À scanner depuis Réglages > Synchronisation sur le téléphone du nouvel athlète.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan from Settings > Sync on the new athlete’s phone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À scanner depuis Réglages > Synchronisation sur le téléphone du nouvel athlète."
          }
        }
      }
    },
    "Écarts calculés sur une base faible : un grand pourcentage y est surtout de l'arithmétique.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes measured against a small base: a large percentage there is mostly arithmetic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écarts calculés sur une base faible : un grand pourcentage y est surtout de l'arithmétique."
          }
        }
      }
    },
