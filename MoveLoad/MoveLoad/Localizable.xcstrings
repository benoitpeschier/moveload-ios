    "Aucun capteur trouvé. Vérifie que le Bluetooth est activé, que MoveLoad y a accès (Réglages > MoveLoad > Bluetooth), et que le capteur est porté et à proximité.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sensor found. Check that Bluetooth is on, that MoveLoad has access to it (Settings > MoveLoad > Bluetooth), and that the sensor is being worn and nearby."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun capteur trouvé. Vérifie que le Bluetooth est activé, que MoveLoad y a accès (Réglages > MoveLoad > Bluetooth), et que le capteur est porté et à proximité."
          }
        }
      }
    },
