    "En attendant que l'enregistrement direct fonctionne : enregistre la séance avec l'app Movesense Showcase, exporte les fichiers acc_stream.json et heartRate_stream.json, puis sélectionne-les ici (les deux à la fois).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until direct recording works: record the session with the Movesense Showcase app, export acc_stream.json and heartRate_stream.json, then pick them both here at once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attendant que l'enregistrement direct fonctionne : enregistre la séance avec l'app Movesense Showcase, exporte les fichiers acc_stream.json et heartRate_stream.json, puis sélectionne-les ici (les deux à la fois)."
          }
        }
      }
    },
    "En attente du signal cardiaque…": {
      "extractionState": "manual",
